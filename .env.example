# Public URL of the deployed Convex backend.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Written automatically by `npx convex dev` for local development.
CONVEX_DEPLOYMENT=

# Optional: add this in Vercel only if Convex deployment is automated in CI.
CONVEX_DEPLOY_KEY=

# Server-only email delivery for newsletter and wholesale forms.
RESEND_API_KEY=
RESEND_FROM_EMAIL="VELONA Website <hello@thevelona.com>"
VELONA_INBOX_EMAIL=hello@thevelona.com
